# Auto-detect text files and normalize line endings to LF on checkin
* text=auto eol=lf

# Swift sources
*.swift   text diff=swift
*.h       text
*.m       text
*.mm      text
*.c       text
*.cpp     text

# Package / config
Package.swift          text diff=swift
Package.resolved       text
*.json                 text
*.yml                  text
*.yaml                 text
*.toml                 text
*.md                   text diff=markdown

# Shell / scripts
*.sh                   text eol=lf

# Binary assets
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.pdf    binary
*.zip    binary
*.tar    binary
*.gz     binary

# Treat lockfile-like outputs as generated in diffs
Package.resolved   linguist-generated=true
